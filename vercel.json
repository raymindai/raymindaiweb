{
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/cv",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cases",
      "destination": "/cases/",
      "permanent": false
    },
    {
      "source": "/cases/:ed(en|ai|wise|deel|beam|blackrock|youtube|deepmind|kurly|makinarocks|meta|monzo|granola|deliveroo|fin|toss|supercent|smilegate|kakao|naver|actai|actai-ko|sierra|bmw|orbital|faculty|hays|oliverwyman|nominal)",
      "destination": "/cases/:ed/",
      "permanent": false
    }
  ]
}
